# Company OS Runtime — local secrets (DO NOT COMMIT)

# --- LLM ---
# true = offline deterministic labs (auto when no API key)
MOCK_LLM=true

# openrouter (default) | openai
LLM_PROVIDER=openrouter

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=AI Company Task Manager
# Optional but recommended by OpenRouter:
# OPENROUTER_HTTP_REFERER=https://github.com/your-org/ai-agent-flow

# Direct OpenAI (only if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- LangSmith ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=ai-company-task-manager

# Optional override; auto-detected as parent of runtime/
# REPO_ROOT=
